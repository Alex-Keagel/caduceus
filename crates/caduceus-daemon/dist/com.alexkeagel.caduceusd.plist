<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alexkeagel.caduceusd</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/caduceusd</string>
        <string>--config</string>
        <string>/etc/caduceus/caduceusd.toml</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>CADUCEUSD_LOG</key>
        <string>info</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/var/log/caduceus/caduceusd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/caduceus/caduceusd.err.log</string>

    <key>WorkingDirectory</key>
    <string>/var/lib/caduceus</string>

    <key>ThrottleInterval</key>
    <integer>5</integer>
</dict>
</plist>
